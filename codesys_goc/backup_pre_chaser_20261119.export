          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">VAR_GLOBAL
	xBtnStart AT %IX0.0 : BOOL;	// Nút START (UR20-8DI-P, kênh 0)
	xBtnStop  AT %IX0.1 : BOOL;	// Nút STOP (UR20-8DI-P, kênh 1)
	xBtnDir   AT %IX0.2 : BOOL;	// Nút ĐỔI CHIỀU chạy (UR20-8DI-P, kênh 2)
	byOut     AT %QB0   : BYTE;	// 8 ngõ ra UR20-8DO-P (bit 0..7 = kênh 0..7)
END_VAR</Single>
