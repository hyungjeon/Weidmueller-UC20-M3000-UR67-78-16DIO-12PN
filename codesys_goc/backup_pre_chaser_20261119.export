  <List2 Name="EntryList">
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">True</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">52b35d30-0d58-4fff-9449-959d04cae447</Single>
        <Single Name="ParentGuid" Type="System.Guid">a57534b9-dd8a-4306-948e-766131a1b3da</Single>
        <Single Name="Name" Type="string">PLC_PRG</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639306866093179768</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Phát hiện sườn lên của các nút nhấn
rtStart(CLK := GVL_IO.xBtnStart);
rtStop(CLK := GVL_IO.xBtnStop);
rtDir(CLK := GVL_IO.xBtnDir);

// START / STOP (STOP ưu tiên)
IF rtStop.Q THEN
	xRun := FALSE;
ELSIF rtStart.Q THEN
	xRun := TRUE;
END_IF

// Mỗi lần nhấn nút 3 thì đảo chiều chạy
IF rtDir.Q THEN
	xDirRev := NOT xDirRev;
END_IF

// Timer bước: tự reset sau mỗi chu kỳ
tStep(IN := xRun AND NOT tStep.Q, PT := tStepTime);

IF NOT xRun THEN
	iStep := 0;
	IF xDirRev THEN
		iStep := 7;
	END_IF
ELSIF tStep.Q THEN
	IF xDirRev THEN
		iStep := iStep - 1;
		IF iStep &lt; 0 THEN
			iStep := 7;
		END_IF
	ELSE
		iStep := iStep + 1;
		IF iStep &gt; 7 THEN
			iStep := 0;
		END_IF
	END_IF
END_IF

// Xuất ngõ ra: chỉ 1 kênh sáng tại mỗi thời điểm; STOP thì tắt hết
IF xRun THEN
	GVL_IO.byOut := SHL(BYTE#1, INT_TO_BYTE(iStep));
ELSE
	GVL_IO.byOut := 0;
END_IF</Single>
            <Single Name="LineInfoPersistence" Type="string">52b35d30-0d58-4fff-9449-959d04cae447_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM PLC_PRG
VAR
	xRun      : BOOL;					// Đang chạy tuần tự
	xDirRev   : BOOL;					// FALSE: kênh 0 -&gt; 7, TRUE: kênh 7 -&gt; 0
	iStep     : INT := 0;				// Kênh đang sáng (0..7)
	tStepTime : TIME := T#500MS;		// Thời gian mỗi bước
	tStep     : TON;					// Timer bước
	rtStart   : R_TRIG;					// Sườn lên nút START
	rtStop    : R_TRIG;					// Sườn lên nút STOP
	rtDir     : R_TRIG;					// Sườn lên nút ĐỔI CHIỀU
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">52b35d30-0d58-4fff-9449-959d04cae447_Decl_LineIds</Single>
          </Single>
        </Single>
